# AI Sales Analyst Copilot environment settings
# Default deterministic mode needs no API key.
LLM_PROVIDER=none

# Optional OpenAI wording layer only. Pandas still calculates all numbers.
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional Anthropic placeholder for future extension.
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional Ollama wording layer.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Optional published Power BI iframe URL. Leave blank to use built-in BI dashboard.
POWERBI_EMBED_URL=

APP_ENV=development
